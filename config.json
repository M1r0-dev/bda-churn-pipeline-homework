{
  "data": {
    "features_path": "data/churn_features.parquet",
    "churn_path": "data/churn_truth.csv",
    "key_column": "subscriber_key",
    "target_column": "churned",
    "excluded_columns": [
      "churn_day_index"
    ],
    "feature_columns": [
      "traffic_gb_30d",
      "traffic_change_ratio",
      "voice_minutes_30d",
      "events_30d",
      "active_days_30d",
      "recency_days",
      "roaming_share_30d",
      "tickets_30d",
      "unresolved_share_30d",
      "network_error_rate_30d"
    ]
  },
  "preprocessing": {
    "test_size": 0.4,
    "val_size": 0.5,
    "random_state": 42,
    "fill_value": 0.0
  },
  "model": {
    "n_estimators": 100,
    "max_depth": 10,
    "min_samples_split": 10,
    "min_samples_leaf": 5,
    "class_weight": "balanced",
    "random_state": 42,
    "n_jobs": 4
  },
  "evaluation": {
    "threshold": 0.5
  },
  "artifacts": {
    "dir": "artifacts",
    "model_name": "model.joblib",
    "features_name": "features.json",
    "metrics_name": "metrics.json",
    "manifest_name": "manifest.json",
    "splits_name": "splits.csv"
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(levelname)s - %(name)s - %(message)s",
    "log_name": "pipeline.log"
  }
}
